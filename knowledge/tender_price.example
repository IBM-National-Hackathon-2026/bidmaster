# CONTOH SANITASI — salin ke tender_price.yaml lalu ganti dengan harga perusahaan.
# File ini yang di-push. Harga asli bersifat rahasia, jangan commit.
# Struktur WAJIB: komponen[].{kode,nama,satuan,harga_dasar} (dibaca validator
# + gate pagu; harga HANYA dari file ini, composer dilarang mengarang angka).
meta:
  sumber: daftar_harga_perusahaan
  mata_uang: IDR
  catatan: Satu-satunya sumber harga; jangan membuat angka di luar daftar ini.
