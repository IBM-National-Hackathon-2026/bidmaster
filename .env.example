# Salin ke .env (jangan commit). Satu-satunya secret backend inti.
# Ganti password seed admin default (bidmaster123) sebelum dipakai bersama tim.
SEED_ADMIN_PASS=bidmaster123

# ── Langflow Integration (opsional) ──────────────────────────────────────────
# Aktifkan integrasi AI dengan mengisi dua variabel di bawah ini.
# Jika kosong, /api/agent akan mengembalikan error 503 dan website tetap berjalan.

# URL Langflow instance kamu (lokal atau cloud)
# Contoh lokal:  http://127.0.0.1:7860
# Contoh cloud:  https://your-langflow.app
LANGFLOW_URL=http://127.0.0.1:7860

# API Key Langflow (dari Projects → MCP Server → Generate API Key)
# JANGAN commit nilai ini ke git
LANGFLOW_API_KEY=

# Catatan watsonx: API key IBM watsonx diisi di dalam Langflow
# (komponen model → Global Variables), BUKAN di file ini.
