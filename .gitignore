# ===== BidMaster .gitignore — CORE ONLY =====
# Prinsip: GitHub hanya berisi inti runnable + README.md satu-satunya *.md.
# Sisanya (docs SDLC, submission, simulator, outputs, arsip, secret) tetap lokal.

# --- Secrets & lokal ---
.env
.env.*
!.env.example
*.pem
*.key
*token*.json
*credentials*.json
**/.bob/
data.db*
*.sqlite*
*.db-shm
*.db-wal
*.db-journal

# --- Single README rule: abaikan semua markdown kecuali README root ---
*.md
!/README.md
# knowledge/*.example TIDAK berakhiran .md -> tetap ter-track
# sebagai data runtime sanitasi. Sengaja.

# --- Data perusahaan asli: jangan push (yang di-push hanya *.example) ---
knowledge/*.yaml

# --- Non-core: docs SDLC + submission form (update lokal saja, tidak push) ---
docs/
AGENTS.md
SKILL.md

# --- Non-core: simulator demo lokal, outputs, arsip ---
simulator/
outputs/
langflow/archive/
langflow/components/
langflow/IMPORT_GUIDE.md
langflow/mcp.json

# --- Python / OS / IDE / Node ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace
node_modules/
*.log
*.bak
*.bak-*
chroma/
pgdata/
