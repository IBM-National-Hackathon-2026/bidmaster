# ===== BidMaster .gitignore =====
# Tujuan: jangan sampai secret / file lokal ikut ke-push ke GitHub.

# --- Secrets & credentials (PENTING) ---
.env
.env.*
*.env
!.env.example
# Config MCP berisi API key asli (contoh tanpa secret: mcp.json.example tetap ke-commit)
langflow/mcp.json
**/.bob/
*token*.json
*credentials*.json
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env_venv/

# --- Hasil generate lokal (draft proposal, docx percobaan) ---
# outputs/ di-ignore, KECUALI 2 file contoh dummy untuk portofolio/juri
outputs/
!outputs/kafe-arunika-proposal-v1.md
!outputs/kafe-arunika-proposal-v2.md
*.log
*.bak
*.bak-*

# --- Data stores lokal (kalau nanti pakai Chroma/Postgres via docker) ---
chroma/
pgdata/
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# --- OS & IDE ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace

# --- Node ---
node_modules/

# --- Arsip ---
# Varian flow lama, tidak diimport. Tetap di-commit sebagai referensi.
!langflow/archive/
