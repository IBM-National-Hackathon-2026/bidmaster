# ===== BidMaster .gitignore — CORE ONLY =====
# GitHub hanya berisi inti runnable + README.md satu-satunya *.md.

# --- Secrets & lokal ---
.env
.env.*
!.env.example
backend/.env
*.pem
*.key
*token*.json
*credentials*.json
**/.bob/
data.db*
*.sqlite*
*.db-shm
*.db-wal
*.db-journal

# --- Single README rule ---
*.md
!/README.md

# --- Data perusahaan asli (yang di-push hanya *.example) ---
knowledge/*.yaml

# --- Non-core: docs, submission, arsip, hasil ---
docs/
AGENTS.md
SKILL.md
simulator/
outputs/
langflow/archive/
langflow/components/
langflow/IMPORT_GUIDE.md
langflow/mcp.json

# --- Stack lama (pensiun, diganti backend/ + frontend/) ---
api/
web/
requirements.txt

# --- Build & deps ---
__pycache__/
*.py[cod]
backend/vendor/
backend/storage/logs/
.phpunit.result.cache
frontend/node_modules/
frontend/dist/
node_modules/

# --- OS / IDE ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.code-workspace
*.log
*.bak
*.bak-*
chroma/
chroma_db/
data/
pgdata/
